    /**
     * PHẦN MỞ RỘNG (2đ): Giải thuật tìm đường kết hợp Bus & Metro
     */
    private void showIntegratedRouteDialog() {
        // 1. Nhập điểm xuất phát (Giả lập: Chợ Thủ Đức)
        String start = JOptionPane.showInputDialog(this, 
                "Nhập địa điểm hiện tại của bạn (Ví dụ: Chợ Thủ Đức, Hàng Xanh):", 
                "Tìm hành trình kết hợp", JOptionPane.QUESTION_MESSAGE);
        
        if (start == null || start.isEmpty()) return;

        // 2. Chọn trạm Metro đích
        String[] metroStations = metroService.getStationNames(); // Lấy từ MetroService
        String dest = (String) JOptionPane.showInputDialog(this, "Chọn trạm Metro đích:",
                "Tìm hành trình", JOptionPane.PLAIN_MESSAGE, null, metroStations, metroStations[0]);

        if (dest == null) return;

        // 3. Logic giả lập kết nối Bus (Dữ liệu thực tế tại TP.HCM)
        String result = "Không tìm thấy tuyến bus phù hợp.";
        
        // Giả lập Tuyến Bus 150 đi qua Chợ Thủ Đức và trạm Metro Bình Thái
        if (start.toLowerCase().contains("thủ đức")) {
            double km = calculateMetroDistance("Bình Thái", dest);
            result = "--- GỢI Ý HÀNH TRÌNH ---\n" +
                     "1. Tại Chợ Thủ Đức: Bắt xe BUÝT SỐ 150.\n" +
                     "2. Xuống tại: TRẠM METRO BÌNH THÁI.\n" +
                     "3. Lên tàu Metro Line 1: Đi đến trạm [" + dest + "].\n" +
                     "-> Chặng Metro dài: " + String.format("%.2f", km) + " km.\n" +
                     "-> Tổng thời gian ước tính: 45 phút.";
        } 
        // Giả lập Tuyến Bus 56 đi qua Hàng Xanh và trạm Metro Tân Cảng
        else if (start.toLowerCase().contains("hàng xanh")) {
            double km = calculateMetroDistance("Tân Cảng", dest);
            result = "--- GỢI Ý HÀNH TRÌNH ---\n" +
                     "1. Tại Ngã tư Hàng Xanh: Bắt xe BUÝT SỐ 56.\n" +
                     "2. Xuống tại: TRẠM METRO TÂN CẢNG.\n" +
                     "3. Lên tàu Metro Line 1: Đi đến trạm [" + dest + "].\n" +
                     "-> Chặng Metro dài: " + String.format("%.2f", km) + " km.\n" +
                     "-> Tổng thời gian ước tính: 30 phút.";
        } else {
            result = "Hiện tại điểm [" + start + "] chỉ có thể đi bộ đến trạm Metro gần nhất.";
        }

        JOptionPane.showMessageDialog(this, result, "Kết quả tìm kiếm", JOptionPane.INFORMATION_MESSAGE);
    }

    // Hàm phụ trợ tính quãng đường dựa trên MetroService hiện có
    private double calculateMetroDistance(String startName, String endName) {
        int sIdx = -1, eIdx = -1;
        String[] names = metroService.getStationNames();
        for (int i = 0; i < names.length; i++) {
            if (names[i].equals(startName)) sIdx = i;
            if (names[i].equals(endName)) eIdx = i;
        }
        if (sIdx != -1 && eIdx != -1) {
            return metroService.calculateDistance(sIdx, eIdx); 
        }
        return 0.0;
    }

    // (Giữ nguyên các hàm helper createMenuItem và class RoundedPanel)
    private JPanel createMenuItem(String title, String iconName, int x, int y) {
        JPanel p = new JPanel(new BorderLayout());
        p.setOpaque(false);
        p.setBounds(x, y, 70, 90);
        JLabel iconLabel = new JLabel();
        iconLabel.setHorizontalAlignment(SwingConstants.CENTER);
        iconLabel.setPreferredSize(new Dimension(70, 60));

        try {
            URL imgUrl = getClass().getResource("/img/" + iconName);
            if (imgUrl != null) {
                ImageIcon originalIcon = new ImageIcon(imgUrl);
                Image scaled = originalIcon.getImage().getScaledInstance(32, 32, Image.SCALE_SMOOTH);
                iconLabel.setIcon(new ImageIcon(scaled));
            } else { iconLabel.setText("?"); }
        } catch (Exception e) { e.printStackTrace(); }

        JPanel iconBg = new JPanel(new BorderLayout()) {
            @Override
            protected void paintComponent(Graphics g) {
                Graphics2D g2 = (Graphics2D) g;
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(new Color(230, 245, 255));
                g2.fillOval(10, 5, 50, 50);
                super.paintComponent(g);
            }
        };
        iconBg.setOpaque(false);
        iconBg.add(iconLabel, BorderLayout.CENTER);

        JLabel textLabel = new JLabel("<html><center>" + title.replace("\n", "<br>") + "</center></html>", SwingConstants.CENTER);
        textLabel.setFont(new Font("SansSerif", Font.PLAIN, 12));
        textLabel.setForeground(new Color(60, 60, 60));

        p.add(iconBg, BorderLayout.NORTH);
        p.add(textLabel, BorderLayout.CENTER);
        p.addMouseListener(new MouseAdapter() {
            public void mouseEntered(MouseEvent e) { p.setCursor(new Cursor(Cursor.HAND_CURSOR)); }
        });
        return p;
    }

    class RoundedPanel extends JPanel {
        private int radius;
        private Color bgColor;
        public RoundedPanel(int radius, Color bgColor) {
            this.radius = radius;
            this.bgColor = bgColor;
            setOpaque(false);
        }
        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(bgColor);
            g2.fillRoundRect(0, 0, getWidth(), getHeight(), radius, radius);
        }
    }

